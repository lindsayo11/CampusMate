DATABASE_URL=sqlite:///./campusmate.db
DEMO_MODE=false
ADMIN_USER_IDS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_INTERNAL_URL=http://127.0.0.1:8000

# Docker Compose password: use URL-safe random characters
POSTGRES_PASSWORD=

DIFY_API_BASE=
DIFY_APP_KEY=

# Public HTTPS origin behind reverse proxy; no trailing slash
APP_ORIGIN=

# Public hostname for optional Caddy production overlay
CAMPUSMATE_DOMAIN=

# Explicit hostname allowlist; blank disables all automated HTTP collection
COLLECTOR_ALLOWED_HOSTS=

# 主体平台版本：增强功能默认关闭
ENABLE_AGENT_UI=true
DEVELOPMENT_DIFY_API_BASE=
DEVELOPMENT_DIFY_APP_KEY=
ENABLE_COLLECTOR_UI=false
COLLECTOR_ENABLED=false

# 持续监测已授权的公开高校栏目；必须配置官方主机白名单并安装栏目配置。
# 不修改原资格规则采集器的校准与审核要求，始终检查 robots。
PUBLIC_NOTICE_WATCH_ENABLED=false

# ---------------------------------------------------------------------------
# 本地开发覆盖开关（严禁用于共享/预发/生产环境）
# ---------------------------------------------------------------------------
# 上游设计对端点校准实施"三方分离"：提交人 + 两名互不相同的审核管理员。
# 该控制用于防止单人既当运动员又当裁判，单人环境无法满足。
# 置 true 仅放宽"身份分离"这一项，使单个管理员可在本地解锁并运行端点。
# 证据要求（robots/条款/许可原文摘录 + 页面 SHA256）不受影响，也不会自动批准。
# 交付、上线或多人环境必须保持 false。
SINGLE_ADMIN_OVERRIDES=false

# ---------------------------------------------------------------------------
# 采集器 robots 覆盖开关（仅限本地开发）
# ---------------------------------------------------------------------------
# 受治理采集器默认"robots 不允许就不采集"，这是 fail-closed 设计。但它有一个
# 真实缺陷：部分政府门户对所有路径都返回整站 HTML（含 /robots.txt），于是
# `GET /robots.txt` 返回 200 + HTML 正文。CPython 的 RobotFileParser 会解析出
# 零条规则并按"全部禁止"处理，从而误伤那些从未设置过抓取限制的官方站点。
#
# 置 true 会在本地采集器中跳过 robots 检查。它不会绕过 HTTPS 白名单、
# 公网 IP pinning、官方域名重定向校验，也不影响任何校准/证据要求。
# 生产环境必须保持 false；遇到 robots 疑问应优先与站点运营方确认。
COLLECTOR_SKIP_ROBOTS=false

# ---------------------------------------------------------------------------
# 采集器明文 HTTP 例外名单（仅限本地开发）
# ---------------------------------------------------------------------------
# 采集器默认强制 HTTPS/443，这是正确默认值。但有官方门户是反过来的：
# www.moe.gov.cn 位于腾讯 EdgeOne 之后，对任何 https:// 请求都返回
# "302 Found -> http://..."（2026-09-29 实测 "/" 与 "/jyb_sjzl/" 均如此），
# 其内容只能通过明文 HTTP 取得。
#
# 置为逗号分隔主机名后，仅这些主机允许走 80 端口明文 HTTP；为空表示全局
# 仅 HTTPS，未列出的主机仍强制 HTTPS。由于明文可被篡改，每次校准记录的
# 页面 SHA256 是唯一完整性锚点，因此该名单必须尽量短，且严禁用于任何
# 携带凭据或个人数据的来源。
COLLECTOR_ALLOW_PLAINTEXT_HOSTS=

# Larger public-source inventories: 1–32 tasks/cycle, with a 15s soft work budget.
PUBLIC_NOTICE_WATCH_BATCH_SIZE=8

# Optional public-original exchange. Use the same random secret on both authorized collectors.
# Keep blank to disable; only the coordinator needs an HTTPS peer root URL.
COLLECTION_EXCHANGE_TOKEN=
COLLECTION_PEER_URL=
COLLECTION_SYNC_INTERVAL_MINUTES=5
COLLECTION_SYNC_BATCH_SIZE=12
